# Komşum backend — ortam değişkenleri örneği.
# Bu dosyayı `.env` olarak kopyalayıp değerleri doldurun. `.env` git'e GİRMEZ.
#
# Not: Spring Boot .env dosyalarını kendiliğinden okumaz. Local çalışırken bu
# değerleri ya IDE'nin "Environment variables" alanına girin, ya da kabuğa
# export edin (PowerShell: $env:JWT_SECRET = "...").

# ── ZORUNLU ───────────────────────────────────────────────────────────────────

# JWT imzalama anahtarı. Base64, en az 256 bit (32 byte).
# Üretmek için: openssl rand -base64 32
# Tanımlı değilse ya da kısaysa uygulama BİLEREK açılmaz.
JWT_SECRET=

# Sohbet mesajlarının şifrelenmesi için (AES-256-GCM). Aynı şekilde üretilir.
# Değiştirilirse eski mesajlar bir daha okunamaz.
MESSAGE_ENCRYPTION_KEY=

# Gmail SMTP uygulama şifresi (şifre sıfırlama e-postaları için).
MAIL_PASSWORD=

# ── OPSİYONEL (varsayılanları application.yml'de) ─────────────────────────────

# Token ömürleri (milisaniye). Varsayılan: 24 saat / 7 gün.
# JWT_EXPIRATION=86400000
# JWT_REFRESH_EXPIRATION=604800000

# Veritabanı — verilmezse local varsayılanları kullanılır.
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/appdb
# SPRING_DATASOURCE_USERNAME=appuser
# SPRING_DATASOURCE_PASSWORD=

# Dosya deposu (MinIO / S3 uyumlu).
# STORAGE_ENDPOINT=http://localhost:9000
# STORAGE_PUBLIC_URL=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_BUCKET=komsum-images

# PORT=8080
